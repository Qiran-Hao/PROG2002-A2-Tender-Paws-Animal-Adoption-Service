# Copy this file to ".env" in the same folder and fill in your own MySQL settings.
# The ".env" file is read by source/api/event_db.js and must not be committed
# with a real password in it.

# MySQL connection used by source/api/event_db.js
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=charityevents_db
DB_CONNECTION_LIMIT=10

# Optional: web server port (each A2 project has its own default port)
# PORT=3201
